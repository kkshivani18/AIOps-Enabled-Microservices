# Terraform directories
.terraform/
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Sensitive variable files
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config files
.terraformrc
terraform.rc

# Terraform plan files
*.tfplan

# Ignore provider binaries/plugins
terraform-provider-*

# OS / IDE
.vscode/
.idea/
.DS_Store
Thumbs.db

# extras
logs.txt